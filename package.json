{
  "name": "@dwtechs/errandler-express",
  "version": "0.1.1",
  "type": "module",
  "description": "Open source Error handler for Express.js services.",
  "keywords": [
    "Error",
    "Error handler"
  ],
  "homepage": "https://github.com/DWTechs/Errandler-express.js",
  "sideEffects": false,
  "main": "dist/errandler-express.js",
  "types": "dist/errandler-express.d.ts",
  "exports": {
    ".": {
      "import": "./dist/errandler-express.js",
      "types": "./dist/errandler-express.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DWTechs/Errandler-express.js"
  },
  "bugs": {
    "url": "https://github.com/DWTechs/Errandler-express.js/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Ludovic Cluber",
    "email": "http://www.lcluber.com/contact",
    "url": "http://www.lcluber.com"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js && npm run test",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "jest --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dwtechs/winstan": "0.7.1"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@types/express": "5.0.6",
    "babel-jest": "29.7.0",
    "core-js": "3.38.1",
    "jest": "29.7.0",
    "rollup": "4.24.0",
    "typescript": "6.0.3"
  }
}
